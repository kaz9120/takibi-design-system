{
	"$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
	"files": {
		"includes": [
			"**",
			"!**/node_modules",
			"!notes",
			"!labs",
			"!**/storybook-static",
			"!**/dist",
			"!**/build",
			"!**/.react-router",
			"!**/.wrangler",
			"!packages/takibi/src/embers.js",
			"!.yomiyasu",
			"!**/*.md"
		]
	},
	"formatter": { "indentStyle": "tab", "lineWidth": 110 },
	"css": { "parser": { "tailwindDirectives": true } },
	"linter": {
		"rules": {
			"preset": "recommended",
			"a11y": {
				"noLabelWithoutControl": {
					"level": "error",
					"options": { "inputComponents": ["Checkbox", "Switch", "Radio", "Input", "Textarea"] }
				}
			}
		}
	},
	"overrides": [
		{
			"includes": ["**/*.css"],
			"linter": { "rules": { "complexity": { "noImportantStyles": "off" } } }
		}
	]
}
