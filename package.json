{
	"name": "takibi-design-system-monorepo",
	"private": true,
	"type": "module",
	"workspaces": [
		"packages/*",
		"apps/*"
	],
	"scripts": {
		"workbench": "bun run --cwd apps/workbench dev",
		"site": "bun run --cwd apps/site dev",
		"build:site": "bun run --cwd apps/site build",
		"build:tokens": "bun run --cwd packages/takibi build:tokens",
		"typecheck": "bun run --cwd packages/takibi typecheck && bun run --cwd apps/workbench typecheck && bun run --cwd apps/site typecheck",
		"lint": "biome check .",
		"format": "biome check --write .",
		"build:workbench": "bun run --cwd apps/workbench build"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.6.6",
		"typescript": "^6"
	}
}
